@startuml Vista Arquitectónica de la Funcionalidad

!pragma layout smetana
left to right direction
skinparam packageStyle rectangle

actor "Usuario" as Usuario
actor "Encargado de Bolsines" as EB
actor "Gerente de Comisión Médica" as GCM
actor "Servidor de Correo" as Correo
actor "GPS Tracker" as GPS
actor "Servidor Google Maps" as Maps
actor "Power BI" as PowerBI

Usuario <|-- EB
Usuario <|-- GCM

rectangle "Sistema de Bolsines" {
  usecase "5. Iniciar sesión" as CU5
  usecase "19. Generar Bolsín" as CU19
  usecase "20. Modificar Bolsín" as CU20
  usecase "21. Eliminar Bolsín" as CU21
  usecase "22. Consultar Bolsín" as CU22
  usecase "28. Registrar recepción\nde bolsín" as CU28
  usecase "29. Notificar recepción\nde bolsín" as CU29
  usecase "36. Consultar seguimiento\nde bolsines" as CU36
  usecase "37. Generar reporte de\nbolsines en tránsito" as CU37
  usecase "38. Generar estadística de\nmovimiento de bolsines" as CU38

  CU28 .> CU29 : <<include>>
}

Usuario --> CU5
EB --> CU19
EB --> CU20
EB --> CU21
EB --> CU22
EB --> CU28
EB --> CU36
GCM --> CU37
GCM --> CU38
CU29 --> Correo
CU36 --> GPS
CU36 --> Maps
CU37 --> PowerBI
CU38 --> PowerBI

@enduml
